# Copy to .env.local for development.
DATABASE_URL=postgres://molingo:molingo@127.0.0.1:5433/molingo

# LiveKit (dev mode defaults; M6)
LIVEKIT_URL=ws://localhost:7880
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=secret
APP_URL=http://localhost:3000

# Show the platform home page (M6d) at hoopo.ir instead of the first teacher's page. Off in production until its placeholders are real.
# PLATFORM_HOME=on

# Where homework files are stored (M8). Production: the /data/uploads volume.
# UPLOAD_DIR=.uploads

# AI homework drafts (OpenAI-compatible API). Server-only; never expose to the client.
# GAP_GPT_API_KEY=
# GAP_GPT_BASE_URL=https://api.gapgpt.app/v1
# GAP_GPT_MODEL=gpt-6.1-sol
