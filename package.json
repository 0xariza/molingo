{
  "name": "molingo",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "sh scripts/start-standalone.sh",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "check:i18n": "node scripts/check-i18n.mjs",
    "check:rtl": "node scripts/check-rtl.mjs",
    "check": "pnpm format:check && pnpm typecheck && pnpm lint && pnpm check:i18n && pnpm check:rtl && pnpm test",
    "db:up": "docker compose -f compose.dev.yml up -d db",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio",
    "user": "tsx --conditions react-server scripts/user.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:seed": "tsx --conditions react-server scripts/seed-dev.ts",
    "test:e2e": "playwright test",
    "audit:prod": "pnpm audit --prod --audit-level high"
  },
  "dependencies": {
    "@date-fns/tz": "1.5.0",
    "@livekit/components-react": "2.9.24",
    "@node-rs/argon2": "^2.2.2",
    "@phosphor-icons/react": "2.1.10",
    "date-fns": "4.4.0",
    "drizzle-orm": "0.45.4",
    "libphonenumber-js": "^1.13.15",
    "livekit-client": "2.22.4",
    "livekit-server-sdk": "2.19.2",
    "lucide-react": "1.61.0",
    "next": "16.4.0",
    "next-intl": "4.14.9",
    "postgres": "3.4.9",
    "react": "19.3.0",
    "react-day-picker": "9.14.0",
    "react-dom": "19.3.0",
    "server-only": "^0.0.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@fontsource-variable/manrope": "5.3.0",
    "@fontsource-variable/vazirmatn": "5.3.0",
    "@fontsource/barlow-condensed": "5.3.0",
    "@fontsource/lalezar": "5.2.5",
    "@playwright/test": "1.64.0",
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "dotenv": "^18.0.7",
    "drizzle-kit": "0.31.11",
    "eslint": "^9",
    "eslint-config-next": "16.4.0",
    "prettier": "3.9.10",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "5.0.4"
  },
  "packageManager": "pnpm@10.14.0"
}
